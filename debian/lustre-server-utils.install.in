debian/tmp/sbin/*			sbin
debian/tmp/usr/sbin/*			usr/sbin
debian/tmp/usr/bin/*			usr/bin
debian/tmp/usr/lib/*.so.*		usr/lib
debian/tmp/usr/lib/lustre/*.so* 	usr/lib/lustre
debian/tmp/lib/systemd/system/* 	lib/systemd/system
debian/tmp/etc/*			etc
debian/tmp/usr/share/bash-completion/completions/*	usr/share/bash-completion/completions
debian/tmp/usr/lib/udev/rules.d/99-lustre.rules	usr/lib/udev/rules.d
debian/tmp/usr/lib/udev/rules.d/99-lustre-server.rules	usr/lib/udev/rules.d
