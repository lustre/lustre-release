LU-21019 ldiskfs: don't change mtime in truncate if NOCMTIME

ext4_truncate() sets mtime and ctime together from current_time(),
which returns the ctime of a NOCMTIME inode, so it copies the ctime
into the mtime. Lustre sets the times of its inodes itself: skip the
update in ext4_truncate() for NOCMTIME inodes.

Index: linux-5.8/fs/ext4/ext4.h
===================================================================
--- linux-5.8.orig/fs/ext4/ext4.h
+++ linux-5.8/fs/ext4/ext4.h
@@ -655,6 +655,13 @@ enum {
 #define EXT4_GOING_FLAGS_LOGFLUSH		0x1	/* flush log but not data */
 #define EXT4_GOING_FLAGS_NOLOGFLUSH		0x2	/* don't flush log nor data */
 
+static inline struct timespec64 ext4_current_time(struct inode *inode)
+{
+	if (IS_NOCMTIME(inode))
+		return inode->i_ctime;
+	return current_time(inode);
+}
+#define current_time(a) ext4_current_time(a)
 
 #if defined(__KERNEL__) && defined(CONFIG_COMPAT)
 /*
Index: linux-5.8/fs/ext4/inode.c
===================================================================
--- linux-5.8.orig/fs/ext4/inode.c
+++ linux-5.8/fs/ext4/inode.c
@@ -4236,7 +4236,8 @@ int ext4_truncate(struct inode *inode)
 	if (inode->i_nlink)
 		ext4_orphan_del(handle, inode);
 
-	inode->i_mtime = inode->i_ctime = current_time(inode);
+	if (!IS_NOCMTIME(inode))
+		inode->i_mtime = inode->i_ctime = current_time(inode);
 	err2 = ext4_mark_inode_dirty(handle, inode);
 	if (unlikely(err2 && !err))
 		err = err2;
